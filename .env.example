# 数据库
# DB_DRIVER 可选 mysql / postgres；留空时按 DB_DSN 自动识别（含 5432/sslmode/postgres:// 视为 PG）
DB_DRIVER=mysql
DB_DSN=username:password@tcp(127.0.0.1:3306)/ops_go?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai
# PostgreSQL 示例（表结构初始化用 sql/ops-go-pg.sql，数据搬迁用 go run ./cmd/migrate2pg）
# DB_DRIVER=postgres
# DB_DSN=postgres://user:password@127.0.0.1:5432/ops_go?sslmode=disable&timezone=Asia/Shanghai

# 堡垒机 SSH 监听端口，留空默认 2222（同机并行验证时可改）
SSH_PORT=

# Web 服务端口
APP_PORT=8080

# Redis
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONN=5

# JWT
JWT_ISSUER=https://ops-go.com
JWT_SECRET=change-me-to-a-random-string

# 登录图形验证码（默认关闭）
CAPTCHA_ENABLED=false

# 强制所有用户绑定 MFA（TOTP）：true 时未绑定用户登录后被引导至绑定页
MFA_REQUIRED=false

# 会话录像保留天数
RECORDING_RETENTION_DAYS=30

# 监控告警（可选，留空使用默认地址）
PROMETHEUS_URL=http://localhost:9090
PUSHGATEWAY_URL=http://localhost:9091
# PROMETHEUS_TOKEN=
# PUSHGATEWAY_TOKEN=
# PROMETHEUS_INSECURE_SKIP_VERIFY=false
# MONITOR_COLLECT_INTERVAL=60
# MONITOR_COLLECT_TIMEOUT=15
# MONITOR_CONCURRENCY=20
# MONITOR_EVAL_INTERVAL=30
# MONITOR_PUSH_TIMEOUT=10
# MONITOR_QUERY_TIMEOUT=15
# WEBHOOK_TIMEOUT=10

# 日志中心（可选，留空使用默认地址）
LOKI_URL=http://localhost:3100
# LOKI_TOKEN=
# LOKI_TIMEOUT=15
# LOKI_INSECURE_SKIP_VERIFY=false
# LOG_COLLECT_INTERVAL=15
# LOG_COLLECT_CONCURRENCY=5
# LOG_COLLECT_TIMEOUT=20
# LOG_COLLECT_MAX_BYTES=524288
# LOG_COLLECT_INITIAL_BACK=65536
# LOG_ALERT_INTERVAL=60
# 说明：CORS 目前由 middleware/cors.go 固定放行全部来源，不读取环境变量；
# 凭证加密使用的 RSA 私钥当前硬编码在 utils/rsa_util.go，尚未支持从环境变量注入。
